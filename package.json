{
  "name": "investor-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "sim": "node dist/cli/main.js",
    "run-daily": "pnpm build && node dist/cli/main.js run-daily",
    "verify": "pnpm build && node dist/cli/main.js verify",
    "rebuild-state": "pnpm build && node dist/cli/main.js rebuild-state",
    "dry-run": "pnpm build && node dist/cli/main.js dry-run",
    "check:ledger": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-ledger.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@strands-agents/sdk": "^1.18.0",
    "yahoo-finance2": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
